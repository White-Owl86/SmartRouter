<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartRouter.UI.ViewModels"
        xmlns:loc="using:SmartRouter.Core.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="950" d:DesignHeight="680"
        x:Class="SmartRouter.UI.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Smart Anti-Sanction &amp; Latency Router"
        Width="1020" Height="720"
        MinWidth="850" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{Binding CurrentFlowDirection}">

    <Window.Styles>
        <Style Selector="TextBlock.headerTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1A202C"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.metricCard">
            <Setter Property="Background" Value="#1E2638"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="BorderBrush" Value="#313D5A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.actionBtn">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <!-- Top App Header -->
        <Border Grid.Row="0" Classes="card" Margin="0,0,0,12" Background="#161B26">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <!-- Status icon + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Ellipse Width="16" Height="16" Fill="{Binding StatusBrush}" StrokeThickness="2" Stroke="#FFFFFF22" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[AppTitle]}" Classes="headerTitle" Foreground="White"/>
                        <TextBlock Text="{Binding Loc[AppSubtitle]}" FontSize="12" Foreground="#A0AEC0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Language Toggle Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
                    <Button Content="فارسی" Click="OnSetFarsiClicked" Classes="actionBtn" Background="#2B354F" Foreground="White" Padding="10,5"/>
                    <Button Content="English" Click="OnSetEnglishClicked" Classes="actionBtn" Background="#2B354F" Foreground="White" Padding="10,5"/>
                </StackPanel>

                <!-- Big Start / Stop Button -->
                <Button Grid.Column="3" 
                        Content="{Binding StartStopButtonText}" 
                        Background="{Binding StartStopButtonBrush}" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="15" 
                        Padding="22,10" 
                        CornerRadius="8"
                        Click="OnStartStopClicked"/>
            </Grid>
        </Border>

        <!-- Main Tabs Content -->
        <TabControl Grid.Row="1">
            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="{Binding Loc[TabDashboard]}">
                <ScrollViewer Margin="0,8">
                    <StackPanel Spacing="16">
                        <!-- Metric Cards Grid -->
                        <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,4">
                            <Border Grid.Column="0" Classes="metricCard" Margin="0,0,6,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[TotalQueries]}" FontSize="11" Foreground="#A0AEC0"/>
                                    <TextBlock Text="{Binding TotalQueries}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="metricCard" Margin="3,0,3,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[SanctionedRouted]}" FontSize="11" Foreground="#9F7AEA"/>
                                    <TextBlock Text="{Binding SanctionedQueries}" FontSize="22" FontWeight="Bold" Foreground="#D6BCFA"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Classes="metricCard" Margin="3,0,3,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[CleanQueries]}" FontSize="11" Foreground="#63B3ED"/>
                                    <TextBlock Text="{Binding CleanQueries}" FontSize="22" FontWeight="Bold" Foreground="#90CDF4"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Classes="metricCard" Margin="3,0,3,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[CacheHitRate]}" FontSize="11" Foreground="#4FD1C5"/>
                                    <TextBlock Text="{Binding CacheHits}" FontSize="22" FontWeight="Bold" Foreground="#81E6D9"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Classes="metricCard" Margin="6,0,0,0">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Loc[CurrentPing]}" FontSize="11" Foreground="#F6AD55"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding AvgLatency, StringFormat='{}{0:F1}'}" FontSize="22" FontWeight="Bold" Foreground="#FBD38D"/>
                                        <TextBlock Text="ms" FontSize="12" Foreground="#A0AEC0" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Routing Overview -->
                        <Border Classes="card">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{Binding Loc[ModeLabel]}" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{Binding Loc[ActiveProvider]}" FontSize="12" Foreground="#A0AEC0"/>
                                        <TextBlock Text="{Binding SelectedAntiSanction.NameFa}" FontSize="15" FontWeight="SemiBold" Foreground="#B794F4"/>
                                        <TextBlock Text="{Binding SelectedAntiSanction.PrimaryIp}" FontSize="12" Foreground="#718096"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Loc[CleanProvider]}" FontSize="12" Foreground="#A0AEC0"/>
                                        <TextBlock Text="{Binding SelectedClean.NameEn}" FontSize="15" FontWeight="SemiBold" Foreground="#63B3ED"/>
                                        <TextBlock Text="{Binding SelectedClean.PrimaryIp}" FontSize="12" Foreground="#718096"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Quick Reachability Status -->
                        <Border Classes="card">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[QuickTestHeader]}" FontWeight="SemiBold" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="{Binding Loc[RunDiagnostic]}" Click="OnRunDiagnosticsClicked" Classes="actionBtn" Background="#3182CE" Foreground="White"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding DiagnosticResults}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="12,8" Background="#111622" CornerRadius="6" BorderBrush="#2D3748" BorderThickness="1">
                                                <Grid ColumnDefinitions="160,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding TargetName}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="11" Foreground="#718096" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MessageFa}" FontWeight="SemiBold" Foreground="#48BB78" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: DNS PROVIDERS & PING -->
            <TabItem Header="{Binding Loc[TabProviders]}">
                <Grid RowDefinitions="Auto,*" Margin="0,8">
                    <!-- Actions -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[ProvidersTitle]}" FontWeight="Bold" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding Loc[TestAllPings]}" Click="OnBenchmarkPingsClicked" Classes="actionBtn" Background="#4299E1" Foreground="White"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Providers}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="14,10" Background="#1A202C" CornerRadius="8" BorderBrush="#2D3748" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Ellipse Grid.Column="0" Width="10" Height="10" Fill="#48BB78" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding NameFa}" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                            <TextBlock Text="{Binding PrimaryIp}" FontSize="12" Foreground="#CBD5E0"/>
                                            <TextBlock Text="{Binding DescriptionFa}" FontSize="11" Foreground="#718096"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" Spacing="2">
                                            <TextBlock Text="{Binding [ProviderLatency], Source={x:Static loc:LocalizationService.Instance}}" FontSize="11" Foreground="#A0AEC0"/>
                                            <TextBlock Text="{Binding LatencyMs, StringFormat='{}{0:F1} ms'}" FontWeight="Bold" FontSize="15" Foreground="#F6AD55"/>
                                        </StackPanel>

                                        <Button Grid.Column="3" Content="{Binding [Apply], Source={x:Static loc:LocalizationService.Instance}}" Tag="{Binding}" Click="OnSelectProviderClicked" Classes="actionBtn" Background="#2B354F" Foreground="White" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: RULES & SERVICES -->
            <TabItem Header="{Binding Loc[TabRules]}">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,8">
                    <!-- Add Custom Rule Bar -->
                    <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding NewDomainInput}" PlaceholderText="{Binding Loc[EnterDomainHint]}" Margin="0,0,8,0" CornerRadius="6" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="{Binding Loc[AddCustomDomain]}" Click="OnAddRuleClicked" Classes="actionBtn" Background="#48BB78" Foreground="White"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding Loc[RulesTitle]}" FontWeight="Bold" FontSize="15" Foreground="White" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Rules}" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="12,6" Background="#151A24" CornerRadius="6">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Pattern}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="11" Foreground="#A0AEC0" Margin="12,0" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="{Binding [DeleteRule], Source={x:Static loc:LocalizationService.Instance}}" Tag="{Binding}" Click="OnDeleteRuleClicked" Classes="actionBtn" Background="#E53E3E" Foreground="White" Padding="8,4" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 4: LIVE LOGS -->
            <TabItem Header="{Binding Loc[TabLogs]}">
                <Grid RowDefinitions="Auto,*" Margin="0,8">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Grid.Column="0" Text="{Binding Loc[LogsTitle]}" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding Loc[ClearLogs]}" Click="OnClearLogsClicked" Classes="actionBtn" Background="#4A5568" Foreground="White"/>
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Logs}" Background="#111622" CornerRadius="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="70,60,240,160,*,70" Margin="4,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="11" Foreground="#718096" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RecordType}" FontSize="11" Foreground="#63B3ED" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Domain}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ResolvedIp}" FontSize="12" Foreground="#48BB78" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding UpstreamUsed}" FontSize="11" Foreground="#CBD5E0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding ResponseTimeMs, StringFormat='{}{0:F1}ms'}" FontSize="11" Foreground="#F6AD55" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 5: SANCTION DIAGNOSTICS LAB -->
            <TabItem Header="{Binding Loc[TabDiagnostics]}">
                <ScrollViewer Margin="0,8">
                    <StackPanel Spacing="16">
                        <Border Classes="card">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{Binding Loc[DiagnosticsTitle]}" FontWeight="Bold" FontSize="16" Foreground="White"/>
                                    <TextBlock Text="{Binding Loc[DiagnosticsDesc]}" FontSize="12" Foreground="#A0AEC0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding Loc[RunDiagnostic]}" Click="OnRunDiagnosticsClicked" Classes="actionBtn" Background="#48BB78" Foreground="White" Padding="16,8"/>
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding DiagnosticResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" Padding="16" Classes="card" Background="#1A202C">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <TextBlock Text="{Binding TargetName}" FontWeight="Bold" FontSize="15" Foreground="White"/>
                                                <TextBlock Text="{Binding Url}" FontSize="12" Foreground="#718096"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Padding="12,6" CornerRadius="6" Background="#22543D" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MessageFa}" FontWeight="Bold" Foreground="#9AE6B4"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: SETTINGS -->
            <TabItem Header="{Binding Loc[TabSettings]}">
                <ScrollViewer Margin="0,8">
                    <StackPanel Spacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{Binding Loc[SettingsTitle]}" FontWeight="Bold" FontSize="16" Foreground="White"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Loc[LanguageLabel]}" FontWeight="SemiBold" Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="فارسی (Persian)" Click="OnSetFarsiClicked" Classes="actionBtn" Background="#2B354F" Foreground="White"/>
                                        <Button Content="English" Click="OnSetEnglishClicked" Classes="actionBtn" Background="#2B354F" Foreground="White"/>
                                    </StackPanel>
                                </StackPanel>

                                <Separator Background="#2D3748"/>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Loc[ListenAddressLabel]}" Foreground="White"/>
                                    <TextBox Text="127.0.0.1" Width="240" HorizontalAlignment="Left" IsReadOnly="True" CornerRadius="6"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Loc[DnsPortLabel]}" Foreground="White"/>
                                    <TextBox Text="53" Width="140" HorizontalAlignment="Left" IsReadOnly="True" CornerRadius="6"/>
                                    <TextBlock Text="{Binding Loc[DnsPortNotice]}" FontSize="11" Foreground="#A0AEC0"/>
                                </StackPanel>

                                <Separator Background="#2D3748"/>

                                <CheckBox IsChecked="True" Content="{Binding Loc[AutoApplyDnsLabel]}" Foreground="White"/>
                                <CheckBox IsChecked="True" Content="{Binding Loc[BypassIntranetLabel]}" Foreground="White"/>
                                <CheckBox IsChecked="True" Content="{Binding Loc[EnableCacheLabel]}" Foreground="White"/>

                                <Button Content="{Binding Loc[Save]}" Click="OnSaveSettingsClicked" Classes="actionBtn" Background="#3182CE" Foreground="White" Width="160" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Notification / Toast Bar -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,6" Background="#2D3748" CornerRadius="6" IsVisible="{Binding IsNotificationVisible}">
            <TextBlock Text="{Binding NotificationMessage}" Foreground="#E2E8F0" FontSize="12" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
